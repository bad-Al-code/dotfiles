################################################################################
#                    Dunst Configuration - macOS Style
################################################################################

[global]
    ### Display ###
    monitor = 0
    follow = mouse
    
    ### Geometry ###
    width = (280, 380)
    height = 300
    origin = top-right
    offset = 20x50
    
    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4
    
    ### Appearance - macOS style ###
    indicate_hidden = yes
    separator_height = 1
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 14
    frame_width = 2
    frame_color = "#52525b99"
    gap_size = 8
    separator_color = auto
    sort = yes
    idle_threshold = 120
    transparency = 10
    
    ### Shadow (requires compositor like picom) ###
    # Enable shadows through window class matching in compositor
    # Dunst notifications will have class "Dunst"
    
    ### Text ###
    font = SF Pro Display 11
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark/48x48/status/:/usr/share/icons/Papirus-Dark/48x48/devices/:/usr/share/icons/Papirus-Dark/48x48/apps/
    
    ### History ###
    sticky_history = yes
    history_length = 20
    
    ### Misc/Advanced ###
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/brave-browser
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 14
    ignore_dbusclose = false
    
    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# macOS-style dark glass appearance with transparency for blur
[urgency_low]
    background = "#1c1c1eE6"
    foreground = "#a1a1aa"
    frame_color = "#52525bCC"
    highlight = "#71717a"
    timeout = 5

[urgency_normal]
    background = "#1c1c1eE6"
    foreground = "#fafafa"
    frame_color = "#71717aDD"
    highlight = "#a1a1aa"
    timeout = 8

[urgency_critical]
    background = "#2c1515E6"
    foreground = "#fafafa"
    frame_color = "#ef4444FF"
    highlight = "#ef4444"
    timeout = 0

# Custom app rules
[spotify]
    appname = Spotify
    timeout = 3
    urgency = low

[telegram]
    appname = TelegramDesktop
    format = "<b>Telegram</b>\n%s\n%b"
    timeout = 5

[screenshot]
    appname = maim
    timeout = 2
    urgency = low
